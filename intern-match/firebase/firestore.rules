rules_version = '2';

// Intern Match: every user can read and write only their own documents.
//   users/{uid}                 profile
//   users/{uid}/saved/{jobId}   saved listings
//   users/{uid}/results/latest  last top 10
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'profile', 'createdAt', 'updatedAt'])
        && (!('profile' in request.resource.data) || request.resource.data.profile.keywords is list && request.resource.data.profile.keywords.size() <= 8);

      match /saved/{jobId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['job', 'savedAt'])
          && request.resource.data.job.id == jobId
          && request.resource.data.job.title is string;
      }

      match /results/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && docId == 'latest'
          && request.resource.data.keys().hasOnly(['jobs', 'meta', 'keywordsKey', 'createdAt'])
          && request.resource.data.jobs is list && request.resource.data.jobs.size() <= 30;
      }
    }
  }
}
