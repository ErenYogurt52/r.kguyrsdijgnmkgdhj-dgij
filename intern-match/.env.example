# ---- Server ----
PORT=3000
# 127.0.0.1 = only this computer. Use 0.0.0.0 to open it to phones on the same Wi-Fi.
HOST=127.0.0.1

# ---- SearchApi.io (Google Jobs) ----
# Dashboard → API key: https://www.searchapi.io  (paste only the key, no quotes, no "Bearer")
SEARCHAPI_KEY=

# ---- SerpApi (Google Jobs), optional second source ----
# The same Google Jobs listings from another service. When SearchApi is out of requests or busy,
# the search moves on to SerpApi by itself. One of the two keys is enough for the site to work.
# Dashboard → API key: https://serpapi.com/manage-api-key
SERPAPI_KEY=
# Which service is asked first (default: searchapi,serpapi)
# SEARCH_PROVIDERS=serpapi,searchapi

# Optional tuning (defaults shown)
# SEARCH_LOCATION=Ho Chi Minh City,Ho Chi Minh City,Vietnam
# Language of Google's labels such as "2 days ago" (listings stay in their own language)
# SEARCH_HL=en
# SEARCH_GL=vn
# RESULTS_LIMIT=10
# MAX_KEYWORDS=3
# MAX_API_CALLS_PER_SEARCH=4
# SEARCHES_PER_USER_PER_DAY=20
# CACHE_TTL_HOURS=12

# ---- Career coach ----
# Every AI below that has a key is used, in this order: Gemini → Ollama → OpenRouter.
# If one is busy (e.g. Gemini "503 high demand"), the coach automatically moves to the next.
# Change the order with e.g. COACH_PROVIDERS=gemini,openrouter

# Google Gemini API (free tier, nothing to download)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Ollama on this computer
# Install https://ollama.com, run: ollama pull gemma4:e4b
# OLLAMA_MODEL=gemma4:e4b
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# OpenRouter
OPENROUTER_API_KEY=
# Default: Google Gemma 4 26B A4B (free)
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# COACH_MESSAGES_PER_USER_PER_DAY=40

# ---- Firebase (Project settings → General → Your apps → Web app → SDK setup and configuration) ----
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# Only for trying the API without Firebase sign-in. Keep true for anything shared.
# REQUIRE_AUTH=true
